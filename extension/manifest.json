{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.12",
  "description": "__MSG_extDesc__",
  "default_locale": "vi",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {"service_worker": "bridge-worker.js"},
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  }
}
