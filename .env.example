# Sao chép tệp này thành .env để cấu hình MUSE2API.
# Đặt khóa riêng bắt đầu bằng m2a_. Bỏ trống để dịch vụ tự tạo và ghi vào nhật ký lúc khởi động.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Địa chỉ và cổng HTTP. Dùng 0.0.0.0 trong Docker.
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# URL công khai, ví dụ https://api.example.com. Bỏ trống để dùng địa chỉ đang truy cập.
MUSE2API_PUBLIC_BASE=

# Tệp thực thi Chromium. Có thể bỏ trống để tự dò.
MUSE2API_CHROMIUM=/usr/bin/chromium

# Cổng nội bộ của Chrome DevTools Protocol.
MUSE2API_CDP_PORT=19210

# Giới hạn xử lý (giây).
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Số tác vụ tạo nội dung có thể chạy đồng thời.
MUSE2API_CONCURRENCY=2

# Đặt 1 nếu muốn duy trì phiên cho cả tài khoản đã tắt.
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Chỉ cân nhắc đặt 1 khi tin cậy người gọi API.
# Cho phép đọc tệp tham chiếu từ đường dẫn cục bộ trên máy chủ.
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# Cho phép tải tệp tham chiếu qua URL trỏ vào mạng riêng hoặc localhost.
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# Tùy chọn cho OpenAI và Gemini. Có thể nhập khóa trong bảng quản trị.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
